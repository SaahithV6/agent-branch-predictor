+export const NO_THINK_MARKER = "[[qm-no-think]]";
+export const FAST_MEMO_MARKER = "[[qm-fast-memo]]";
+const FAST_MEMO_TTL_MS = 10 * 60_000;
+const fastMemo = new Map<string, { reply: string; at: number }>();
+
+function fastMemoKey(model: string, text: string): string {
+  return createHash("sha256").update(`${model}\n${FAST_PATH_SYSTEM_PROMPT}\n${text}`).digest("hex");
+}
+
+function recallFastMemo(key: string): string | undefined {
+  const hit = fastMemo.get(key);
+  if (!hit) return undefined;
+  if (Date.now() - hit.at > FAST_MEMO_TTL_MS) {
+    fastMemo.delete(key);
+    return undefined;
+  }
+  return hit.reply;
+}
