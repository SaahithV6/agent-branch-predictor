+  if (TOOL_SCOPE_RE.test(turn.input)) return undefined;
+  const match = TOOL_SCOPE_RE.exec(turn.environment ?? "");
+  return match ? new Set(match[1]!.split(",").filter(Boolean)) : undefined;
+}
+
+export function fastPathTurn(turn: HarnessTurnInput): boolean {
+  return markedTurn(turn, FAST_PATH_MARKER);
+}
