+type ProcessIdentity = { uid: number; gid: number };
+
+interface WarmProcess {
+  jail: string;
+  child: SpawnedProcess;
+  timer: NodeJS.Timeout;
+}
+
+const WARM_PROCESS_TTL_MS = 10 * 60_000;
+const warm = new Map<string, WarmProcess>();
+
+function spawnKey(options: SpawnOptions, jail: string): string {
+  const strip = (v: string) => v.replaceAll(jail, "<jail>");
+  const env = Object.entries(options.env ?? {})
+    .map(([k, v]) => [k, typeof v === "string" ? strip(v) : v])
+    .sort(([a], [b]) => String(a).localeCompare(String(b)));
+  return JSON.stringify([options.command, options.args.map(strip), strip(options.cwd ?? ""), env]);
+}
+
+function retireWarm(key: string, entry: WarmProcess): void {
+  clearTimeout(entry.timer);
+  entry.child.kill("SIGTERM");
+  rmSync(entry.jail, { recursive: true, force: true });
+  if (warm.get(key) === entry) warm.delete(key);
+}
+
+function prewarm(key: string, options: SpawnOptions, jail: string, identity?: ProcessIdentity): void {
+  const next = mkdtempSync(join(tmpdir(), "qm-claude-"));
+  if (identity) chownSync(next, identity.uid, identity.gid);
+  const swap = (v: string) => v.replaceAll(jail, next);
+  const env = Object.fromEntries(Object.entries(options.env ?? {}).map(([k, v]) => [k, typeof v === "string" ? swap(v) : v]));
+  const spec = { ...options, args: options.args.map(swap), cwd: swap(options.cwd ?? next), env, signal: new AbortController().signal };
+  const entry: WarmProcess = {
+    jail: next,
+    child: spawnClaudeProcess(spec, identity),
+    timer: setTimeout(() => retireWarm(key, entry), WARM_PROCESS_TTL_MS),
+  };
+  entry.timer.unref?.();
+  const previous = warm.get(key);
+  if (previous) retireWarm(key, previous);
+  warm.set(key, entry);
+}
+
+export function warmProcessSpawner(jail: string, enabled: boolean, identity?: ProcessIdentity) {
+  return (options: SpawnOptions): SpawnedProcess => {
+    if (!enabled) return spawnClaudeProcess(options, identity);
+    const key = spawnKey(options, jail);
+    const entry = warm.get(key);
+    let child: SpawnedProcess | undefined;
+    if (entry) {
+      warm.delete(key);
+      clearTimeout(entry.timer);
+      if (entry.child.exitCode === null) {
+        child = entry.child;
+        const cleanup = () => rmSync(entry.jail, { recursive: true, force: true });
+        entry.child.once("exit", cleanup);
+        options.signal?.addEventListener("abort", () => entry.child.kill("SIGTERM"), { once: true });
+      } else rmSync(entry.jail, { recursive: true, force: true });
+    }
+    child ??= spawnClaudeProcess(options, identity);
+    try {
+      prewarm(key, options, jail, identity);
+    } catch (error) {
+      swallow("claude: prewarm", error);
+    }
+    return child;
+  };
+}
